# =============================================================================
# Warungio Marketplace - Flutter App Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# For build-time vars, use --dart-define=KEY=VALUE when running flutter commands.
# =============================================================================

# ── Environment ──────────────────────────────────────────────────────────
# Options: development | staging | production
APP_ENV=development

# ── API Configuration ────────────────────────────────────────────────────
# Base URL for the Warungio Django backend
API_BASE_URL_DEV=http://localhost:8000
API_BASE_URL_STAGING=https://staging-api.warungio.com
API_BASE_URL_PROD=https://api.warungio.com

# ── Midtrans Payment Gateway ────────────────────────────────────────────
# Get these from your Midtrans dashboard: https://dashboard.midtrans.com
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false

# ── Firebase ────────────────────────────────────────────────────────────
# Google services JSON (Android) from Firebase Console
# Place in: android/app/google-services.json
# GoogleService-Info.plist (iOS) from Firebase Console
# Place in: ios/Runner/GoogleService-Info.plist

# ── Google Sign-In ──────────────────────────────────────────────────────
# OAuth 2.0 Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Facebook Login ──────────────────────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# ── Apple Sign-In ───────────────────────────────────────────────────────
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# ── Google Maps ─────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── Sentry (Error Tracking) ─────────────────────────────────────────────
# Get DSN from: https://sentry.io
SENTRY_DSN=

# ── Feature Flags ───────────────────────────────────────────────────────
ENABLE_AI_FEATURES=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_CHAT=true
