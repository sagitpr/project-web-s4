{
  "name": "warungio-backend",
  "version": "1.0.0",
  "description": "Backend Express untuk Warungio, berjalan berdampingan dengan backend PHP lama.",
  "scripts": {
    "start": "echo 'Warungio uses Django backend. Run: cd django_backend && python manage.py runserver 0.0.0.0:8000'",
    "dev": "echo 'Warungio uses Django backend. Run: cd django_backend && python manage.py runserver 0.0.0.0:8000'",
    "build:css": "tailwindcss -i django_backend/static/css/tailwind-input.css -o django_backend/static/css/tailwind.css --minify"
  },
  "keywords": [
    "warungio",
    "express",
    "mysql"
  ],
  "author": "Sagit Faturrakhman",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "latest",
    "bootstrap": "^5.3.8",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "jsonwebtoken": "latest",
    "mysql2": "latest"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "autoprefixer": "^10.5.4",
    "cypress": "^15.19.0",
    "nodemon": "latest",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sagitpr/project-web-s4.git"
  },
  "bugs": {
    "url": "https://github.com/sagitpr/project-web-s4/issues"
  },
  "homepage": "https://github.com/sagitpr/project-web-s4#readme"
}
