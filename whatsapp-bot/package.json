{
  "name": "warungio-whatsapp-bot",
  "version": "1.0.0",
  "description": "Warungio WhatsApp Chatbot — Asisten Virtual untuk Warungio",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:dev": "node --watch src/index.js",
    "clear-session": "node -e \"const fs=require('fs'),p=require('path');const d=p.resolve('./session');if(fs.existsSync(d)){fs.readdirSync(d).forEach(f=>fs.unlinkSync(p.join(d,f)));console.log('Session cleared');}\""
  },
  "keywords": [
    "whatsapp",
    "chatbot",
    "baileys",
    "warungio",
    "gemini"
  ],
  "license": "MIT",
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.1.3",
    "qrcode-terminal": "^0.12.0",
    "node-fetch": "^2.7.0",
    "dotenv": "^16.4.7"
  }
}
