.git
.gitignore

# Environment — ensure NO .env files get baked into image
.env
.env.*
.env.local
.env.production
.env.development
.env.staging
django_backend/.env
django_backend/.env.*
.venv
venv

# Python
__pycache__
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg
*.sqlite3
django_backend/db.sqlite3
.coverage
htmlcov/
.pytest_cache/

# Node / PHP (not used in Cloud Run)
node_modules
vendor/
composer.phar
composer.lock
package-lock.json
yarn.lock

staticfiles/
media/
django_backend/staticfiles/
django_backend/media/
src/
check_sizes.py
check_gcloudignore.py

# Logs
*.log
logs

# IDE & OS
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# Large local-only directories
mariadb-10.11.10/
mariadb-10.11.10-winx64/

# Database dumps & backups
database/backups/
database/*.sql.gz
database/*.sql.zip

# Media & Heavy static assets
**/*.png
**/*.jpg
**/*.jpeg
**/*.mp4
**/*.gif
**/*.webp
**/*.wav
**/*.mp3
**/*.zip
**/*.tar.gz
**/*.tgz