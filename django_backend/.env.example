# =============================================================================
# Warungio Django Backend — Django-Specific Environment Variables
# =============================================================================
#
# DATABASE CONFIGURATION (single source of truth):
#   Edit the ROOT .env file (project-root/.env) for shared DB settings:
#     DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASS
#
#   All backends (PHP, Node.js, Django) share the same root .env.
#
# This file only contains Django-specific overrides.
# Copy this file to .env to override Django settings locally.

# Django
DJANGO_SECRET_KEY=your-secret-key-change-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database — only set here if you need to override the root .env
# Otherwise, set these in the root .env file.
USE_MYSQL=False
# DB_NAME=warungio_db
# DB_USER=root
# DB_PASS=
# DB_HOST=localhost
# DB_PORT=3306

# Redis (for Channels, Caching, Celery)
REDIS_URL=redis://localhost:6379/0

# Email (OTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@warungio.com

# Social Auth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
APPLE_CLIENT_ID=com.warungio.app
APPLE_CLIENT_SECRET=
APPLE_KEY_ID=
APPLE_TEAM_ID=

# Midtrans Payment
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=False

# OTP
OTP_EXPIRE_MINUTES=15
