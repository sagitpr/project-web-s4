  /api/suppliers/:
    get:
      operationId: api_suppliers_list
      description: List active suppliers with search, filter, pagination.
      parameters:
      - in: query
        name: category
        schema:
          type: integer
      - in: query
        name: city
        schema:
          type: string
      - in: query
        name: city__in
        schema:
          type: array
          items:
            type: string
        description: Multiple values may be separated by commas.
        explode: false
        style: form
      - in: query
        name: is_featured
        schema:
          type: boolean
      - name: ordering
        required: false
        in: query
        description: Which field to use when ordering the results.
        schema:
          type: string
      - name: page
        required: false
        in: query
        description: A page number within the paginated result set.
        schema:
          type: integer
      - in: query
        name: rating_avg__gte
        schema:
          type: number
      - in: query
        name: rating_avg__lte
        schema:
          type: number
      - name: search
        required: false
        in: query
        description: A search term.
        schema:
          type: string
      - in: query
        name: status
        schema:
          type: string
          enum:
          - active
          - blacklisted
          - inactive
          - pending
          - suspended
        description: |-
          * `pending` - Pending
          * `active` - Active
          * `suspended` - Suspended
          * `blacklisted` - Blacklisted
          * `inactive` - Inactive
      - in: query
        name: verification_level
        schema:
          type: string
          title: Level Verifikasi
          enum:
          - premium
          - unverified
          - verified
        description: |-
          * `unverified` - Unverified
          * `verified` - Verified
          * `premium` - Premium
      tags:
      - api
      security:
      - jwtAuth: []
      - cookieAuth: []
      - {}
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/PaginatedSupplierListList'
          description: ''
