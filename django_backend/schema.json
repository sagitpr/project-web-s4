    post:
      operationId: api_orders_status_create
      description: |-
        Memperbarui status pesanan oleh seller. Mendukung alur pengiriman hyperlocal:
        - `processed`: Konfirmasi pesanan
        - `ready_pickup`: Siap dijemput kurir
        - `courier_pickup`: Kurir menjemput (isi driver_name & driver_phone)
        - `on_delivery`: Dalam perjalanan
        - `completed`: Pesanan diterima
        - `cancelled`: Batalkan pesanan
      summary: Update Status Pesanan (Seller)
      parameters:
      - in: path
        name: order_id
        schema:
          type: integer
        required: true
      tags:
      - Orders
      requestBody:
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/OrderStatusRequest'
          application/x-www-form-urlencoded:
            schema:
              $ref: '#/components/schemas/OrderStatusRequest'
          multipart/form-data:
            schema:
              $ref: '#/components/schemas/OrderStatusRequest'
        required: true
      security:
      - jwtAuth: []
      - cookieAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/OrderDetail'
          description: Order updated successfully
        '400':
          description: Bad Request
        '404':
          description: Not Found
