# =============================================================================
# Warungio Marketplace — Environment Variables
# Copy this file to .env and fill in your values.
# Usage: cp .env.example .env && nano .env
# =============================================================================

# ── Database (MariaDB/MySQL) ────────────────────────────────────────────────
DB_NAME=warungio_db
DB_USER=warungio
DB_PASS=change_this_password
DB_ROOT_PASS=change_this_root_password
DB_HOST=mysql
DB_PORT=3306
DB_HOST_TYPE=tcp                     # "tcp" for docker-compose; "cloud_sql" for Cloud Run
CLOUD_SQL_INSTANCE=                  # your-project:region:instance (for cloud_sql only)
CLOUD_SQL_SOCKET=                    # optional: custom Unix socket path

# ── Django Security ─────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=generate-a-long-random-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=Warungio.web.id,www.Warungio.web.id,38.49.208.28,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://Warungio.web.id,http://www.Warungio.web.id,http://38.49.208.28
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,https://warungio.web.id

# ── Redis (Channels, Cache, Celery) ─────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_CHANNEL_LAYER_REQUIRED=true

# ── HTTPS / HSTS ────────────────────────────────────────────────────────────
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0

# ── Email (OTP Delivery) ────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@warungio.com

# ── Midtrans Payment ────────────────────────────────────────────────────────
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=false

# ── Social Auth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_KEY_ID=
APPLE_TEAM_ID=

# ── Google Maps ─────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── BinderByte ──────────────────────────────────────────────────────────────
BINDERBYTE_API_KEY=

# ── Vertex AI ───────────────────────────────────────────────────────────────
GCP_PROJECT_ID=
GCP_REGION=us-central1
VERTEX_AI_ENDPOINT_ID=openapi
VERTEX_AI_MODEL=meta/llama-3.3-70b-instruct-maas
AI_CHAT_ENABLED=true
AI_CHAT_ESCALATION_ENABLED=true
VERTEX_API_KEY=

# ── WhatsApp OTP ────────────────────────────────────────────────────────────
WHATSAPP_PROVIDER=fonnte               # Provider: fonnte, twilio, wati, direct
WHATSAPP_API_KEY=
WHATSAPP_API_URL=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BASE_URL=https://wati.com/api/v1

# Fonnte (Indonesian WhatsApp Gateway)
WHATSAPP_FONNTE_API_KEY=fsk_ad36f002b2cc6b6349086f7c5de92ccff179a5d4a3907d17d0464252f337b966

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ── Rate Limiting ───────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=15
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# ── Superuser ───────────────────────────────────────────────────────────────
DJANGO_SUPERUSER_EMAIL=admin@warungio.com
DJANGO_SUPERUSER_PASSWORD=change_admin_password

# ── Tuning ──────────────────────────────────────────────────────────────────
USE_MYSQL=true
DB_ENGINE=django.db.backends.mysql
PORT=8000
DATABASE_IS_REQUIRED=true
DB_RETRIES=60
DB_RETRY_DELAY=2
