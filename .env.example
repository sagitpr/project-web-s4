# =============================================================================
# Warungio Marketplace — Environment Variables
# Copy this file to .env and adjust values for your deployment.
# =============================================================================

# ── Django Core ──
DJANGO_SECRET_KEY=your-super-secret-key-change-this-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ── Database (MySQL/MariaDB) ──
USE_MYSQL=true
DB_ENGINE=django.db.backends.mysql
DB_NAME=warungio_db
DB_USER=warungio
DB_PASS=warungio_secret
DB_HOST=mysql
DB_PORT=3306

# ── Database Connection Type ──
# "tcp" for docker-compose / local dev (uses DB_HOST:DB_PORT)
# "cloud_sql" for Google Cloud Run (uses CLOUD_SQL_SOCKET / Unix socket)
DB_HOST_TYPE=tcp

# ── Google Cloud SQL (only used when DB_HOST_TYPE=cloud_sql) ──
CLOUD_SQL_INSTANCE=project-010f7e8f-fc0f-46fb-8c7:asia-southeast2:warungio-db
# Cloud SQL Auth Proxy / Connector creates socket at:
# /cloudsql/PROJECT:REGION:INSTANCE
# Optionally override with CLOUD_SQL_SOCKET if using a custom path
# CLOUD_SQL_SOCKET=/cloudsql/your-project:asia-southeast2:your-instance

# ── Redis (Channels, Cache, Celery) ──
REDIS_URL=redis://redis:6379/0

# ── Security (enable for production) ──
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# ── CORS ──
CORS_ALLOWED_ORIGINS=http://localhost:80,http://localhost:3000,https://warungio.com

# ── Email (OTP delivery) ──
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=sagitistaratas465@gmail.com
EMAIL_HOST_PASSWORD=Sagitf465#$@
DEFAULT_FROM_EMAIL=noreply@warungio.com

# ── BinderByte (Courier Tracking API) ──
# Get your API key at: https://binderbyte.com
BINDERBYTE_API_KEY=7849e8ee297461a34a7a391fee51a89e63d1ccb82b1308176187a60de42ff601

# ── OTP Configuration ──
OTP_EXPIRE_MINUTES=15

# ── Midtrans Payment ──
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_MERCHANT_ID=
MIDTRANS_IS_PRODUCTION=

# ── Social Authentication ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
APPLE_CLIENT_ID=com.warungio.app
APPLE_CLIENT_SECRET=your-apple-client-secret
APPLE_KEY_ID=your-apple-key-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_PRIVATE_KEY=your-apple-private-key

# ── Google Maps API ──
# Get API key from: https://console.cloud.google.com
# Make sure to enable Maps JavaScript API and set API restrictions
GOOGLE_MAPS_API_KEY=AIzaSyBXr9qOQ5DfcxG-tH288SE9tpdJ5ty7S4I

# ── Vertex AI (AI Customer Service) ──
# Setup: https://cloud.google.com/vertex-ai/docs
GCP_PROJECT_ID=project-010f7e8f-fc0f-46fb-8c7
GCP_REGION=us-central1
VERTEX_AI_ENDPOINT_ID=openapi
VERTEX_AI_MODEL=meta/llama-3.3-70b-instruct-maas
AI_CHAT_ENABLED=true
AI_CHAT_ESCALATION_ENABLED=true
VERTEX_API_KEY=AIzaSyBLDzpQcpIaqgcFiLt6fdQyYlEB5SAw2UE
# ── Google Cloud Authentication ──
# Use Application Default Credentials or set this:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
