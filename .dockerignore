# =============================================================================
# Warungio Marketplace — Docker Build Context Ignore (OPTIMIZED)
# Mengurangi build context dari ~700MB menjadi <50MB untuk VPS 1GB RAM
# =============================================================================

# ── Version Control ──────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes
.gitmodules
.gitkeep

# ── Environment Files ────────────────────────────────────────────────────────
.env
.env.*
.env.local
.env.production
.env.development
*.env

# ── Python — Bytecode & Cache ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl
.python-version
pip-log.txt
pip-delete-this-directory.txt

# ── Python — Virtual Environment (LOCAL — jangan ikut ke image) ──────────────
venv/
.venv/
django_backend/venv/
django_backend/.venv/

# ── Django — Generated / Static / Media ──────────────────────────────────────
django_backend/db.sqlite3
*.sqlite3
# ── Generated output (collectstatic result) — jangan ikut sebagai source ──
django_backend/staticfiles/
staticfiles/
# ── Media uploads (isi runtime, bukan source) ──
django_backend/media/
media/
# ── NOTE: django_backend/static/ TIDAK di-exclude karena merupakan
#    STATICFILES_DIRS utama untuk collectstatic. Tanpa direktori ini,
#    collectstatic tidak punya source files untuk disalin ke volume.
#    Semua file CSS/JS/images project ada di sini.

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
/var/log/

# ── Node.js / Frontend Dependencies ──────────────────────────────────────────
node_modules/
package-lock.json
yarn.lock
yarn-debug.log*
yarn-error.log*
.pnpm-store/
bun.lockb
bun.lock
npm-debug.log*

# ── PHP / Composer (tidak dipakai di Docker) ─────────────────────────────────
vendor/
composer.phar
composer.lock

# ── IDE & Editor ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
*.sublime-project
*.sublime-workspace

# ── Docker ───────────────────────────────────────────────────────────────────
.docker/
docker-compose*.yml
Dockerfile
Dockerfile.*
.dockerignore

# ── CI/CD ────────────────────────────────────────────────────────────────────
.github/
.gitlab-ci.yml
.gitlab-ci.yaml
Jenkinsfile
cloudbuild.yaml
cloudrun.yaml
*.tf
*.tfstate
*.tfstate.*

# ── Test & Coverage ──────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
*.cover
*coverage/

# ── Archives & Backups ───────────────────────────────────────────────────────
*.zip
*.tar.gz
*.rar
*.7z
*.bak
*.orig
*.old
*.save
# Note: tidak gunakan *.gz broad karena bisa mengganggu pattern matching
# Archive SQL backup (pattern spesifik):
database/backups/
database/*.sql.gz
database/*.sql.zip

# ── Documentation (tidak dibutuhkan di runtime) ──────────────────────────────
README.md
PROJECT_STRUCTURE.md
docs/
CONTEXT.md
# Note: *.md tidak digunakan broad — file .md spesifik saja yang di-exclude
# karena selective COPY sudah memastikan file .md tidak masuk ke image.

# ── Assets & Reports (tidak dibutuhkan di image production) ─────────────────
stitch_assets/
stitch_assets_download.py
reports/

# ── Tools & Scripts (hanya untuk development/deployment) ─────────────────────
tools/
scripts/
install.ps1
powershell.bat
eval_settings.py
print_settings.py
package.json
skills-lock.json

# ── Frontend Template Dir (tidak masuk image — dikopi selektif via Dockerfile) ─
# home/ dan seller/ adalah Django template directories, bukan static frontend.
# Mereka DIKOPI secara selektif oleh Dockerfile (runtime stage) untuk
# TemplateView di urls.py. Tidak perlu di-exclude dari build context.
#
# shared/ (12KB) juga tidak di-exclude karena diperlukan sebagai sumber
# file statis (STATICFILES_DIRS) untuk collectstatic di stage build-static.

# ── Database & Infra Configs (dipakai oleh container lain via volume mount) ──
mariadb/
nginx/

# ── Agent & Meta Files ──────────────────────────────────────────────────────
.agent/
.agents/
.hintrc
