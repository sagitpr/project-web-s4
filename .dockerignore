# =============================================================================
# Warungio Marketplace — .dockerignore
# Mencegah file tidak perlu masuk ke Docker image (menghemat 150MB+)
# =============================================================================

# Git
.git
.gitignore
.gitattributes

# Environment
.env
.env.*

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
*.egg
.venv/
venv/
.env

# Node (tidak digunakan di Docker)
node_modules/
package.json
package-lock.json

# Static files (regenerated by collectstatic)
staticfiles/

# Logs
logs/*.log

# Database
*.sqlite3
*.sql
backup_*.sql

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose*.yml
Dockerfile
.dockerignore

# Documentation
docs/
*.md
README.md

# Development
scripts/
tools/
reports/
