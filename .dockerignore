# =============================================================================
# Warungio Marketplace — Docker Ignore
# Prevent bloated or unnecessary files from entering Docker build context
# =============================================================================

# Git
.git/
.gitignore
.gitattributes

# Environment — NEVER bake .env files into the image!
.env
.env.*
.env.local
.env.production
.env.development
.env.staging
django_backend/.env
django_backend/.env.*
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg
*.sqlite3
django_backend/db.sqlite3
.coverage
htmlcov/
.pytest_cache/
*.pyc

# Node / PHP (not used in Docker image)
node_modules/
vendor/
composer.phar
composer.lock
package-lock.json
yarn.lock

# Large local-only directories
mariadb-10.*/
mariadb-10.*-winx64/

# Static / Media (generated at runtime via collectstatic)
django_backend/staticfiles/
django_backend/media/

# Logs
*.log
logs/

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Documents & backups
*.md
*.txt
*.zip
*.tar.gz
*.rar
*.7z

# Database dumps (not needed in image, init.sql sourced via volume mount)
database/backups/
database/*.sql.gz
database/*.sql.zip

# Cloud-only configs (not needed for Docker Compose)
cloudrun.yaml
deploy_run.py
deploy_output.txt
service_describe.txt
describe_service.py
print_settings.py
eval_settings.py

# Tools
tools/
install.ps1
powershell.bat
