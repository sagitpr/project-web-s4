# =============================================================================
# Warungio Marketplace — Docker Ignore
# Prevent bloated or unnecessary files from entering Docker build context
# =============================================================================

# Git
.git/
.gitignore
.gitattributes

# Environment — ensure NO .env files get baked into image
.env
.env.*
.env.local
.env.production
.env.development
.env.staging
django_backend/.env
django_backend/.env.*
.venv/
venv/


# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg
*.sqlite3
django_backend/db.sqlite3
.coverage
htmlcov/
.pytest_cache/

# Node / PHP (not used in Docker)
node_modules/
vendor/
composer.phar
composer.lock
package-lock.json
yarn.lock

# Large local-only directories
mariadb-10.11.10/
mariadb-10.11.10-winx64/

# Static / Media (generated at runtime)
django_backend/staticfiles/
django_backend/media/

# Logs
*.log
logs/

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Documents & backups
analisis-spec.md
warungio-spec.md
CLEANUP-PLAN.md
README.md
nul
*.zip
*.tar.gz
*.rar
*.7z

# Database dumps & backups (not needed in image)
database/backups/
database/*.sql.gz
database/*.sql.zip
